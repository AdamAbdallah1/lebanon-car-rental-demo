{
  "name": "car-rental-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "functions:build": "npm --prefix functions run build",
    "emulators:start": "firebase emulators:start --project demo-cedars-drive",
    "emulators:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-cedars-drive node functions/scripts/seed-emulator.mjs",
    "roles:set": "node functions/scripts/set-role.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cedars-drive \"node --test --test-reporter=spec tests/rules.test.mjs\"",
    "test:functions": "npm run functions:build && firebase emulators:exec --only firestore,auth,functions --project demo-cedars-drive \"node --test --test-reporter=spec functions/test/functions.test.mjs\"",
    "test": "npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
