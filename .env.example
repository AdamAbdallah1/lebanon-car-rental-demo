# Firebase web config — copy to .env.local and fill in from the Firebase console.
# Never commit .env.local. See src/lib/firebase/README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Local Emulator Suite ───────────────────────────────────────────────────────
# Set to 1 to point the web app at a running Emulator Suite instead of the real
# project. The emulator ignores the config values above, so placeholders are
# enough — but they must be non-empty, because `isFirebaseConfigured` decides
# whether the Firestore adapter or the seed adapter is used.
#
#   terminal 1:  npm run emulators:start
#   terminal 2:  npm run emulators:seed        (catalogue only; never bookings)
#   terminal 3:  VITE_FIREBASE_EMULATOR=1 ...  see below
#
# The flag is opt-in and never inferred. Never set it in a deployment, and
# never commit `.env.local`.
# VITE_FIREBASE_EMULATOR=1
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional demo tuning (see src/lib/firebase/README.md § QA hooks)
# VITE_SEED_LATENCY_MS=120
# VITE_DEMO_FAIL=1
