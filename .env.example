# Firebase web config — copy to .env.local and fill in from the Firebase console.
# Never commit .env.local. See src/lib/firebase/README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional demo tuning (see src/lib/firebase/README.md § QA hooks)
# VITE_SEED_LATENCY_MS=120
# VITE_DEMO_FAIL=1
